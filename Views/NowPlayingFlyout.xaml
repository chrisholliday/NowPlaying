<Window x:Class="NowPlaying.Views.NowPlayingFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NowPlaying.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Now Playing"
        Width="380"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="FluentCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentCircleButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1086E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppBadgeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shell with drop shadow -->
    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Color="#000000"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="8" />
        </Border.Effect>

        <!-- Main Window Background (Acrylic / Dark Fluent) -->
        <Border Background="#EB202022"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0"
                        Background="#20000000"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#0098FF"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="{Binding HeaderTitle}"
                                       Foreground="#FFFFFF"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#A0FFFFFF"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                ToolTip="Close Flyout">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#30FFFFFF" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <Grid Grid.Row="1" Margin="12,10,12,14">
                    <!-- Active Media Sessions List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="480"
                                  Focusable="False">
                        <ItemsControl ItemsSource="{Binding MediaCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MediaCardViewModel}">
                                    <Border Background="#302A2D34"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,0,0,10"
                                            Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Row 0: App info / Click to focus -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 1: Artwork + Details -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 2: Progress timeline (optional) -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 3: Playback Controls -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: App Badge / Switch to app -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Button Style="{StaticResource AppBadgeButtonStyle}"
                                                        Command="{Binding FocusAppCommand}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="Click to switch directly to this application window">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding AppIcon}"
                                                               Width="16"
                                                               Height="16"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AppName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0" />
                                                        <TextBlock Text="↗"
                                                                   FontSize="11"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Playing indicator pulse -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}">
                                                    <Border Width="7"
                                                            Height="7"
                                                            CornerRadius="4"
                                                            Background="#00D26A"
                                                            Margin="0,0,5,0" />
                                                    <TextBlock Text="Playing"
                                                               FontSize="11"
                                                               Foreground="#00D26A"
                                                               FontWeight="Medium" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 1: Artwork & Track Metadata -->
                                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Artwork -->
                                                <Border Grid.Column="0"
                                                        Width="60"
                                                        Height="60"
                                                        CornerRadius="8"
                                                        Background="#20FFFFFF"
                                                        ClipToBounds="True"
                                                        Margin="0,0,12,0">
                                                    <Grid>
                                                        <!-- Placeholder disc icon -->
                                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5z"
                                                              Fill="#40FFFFFF"
                                                              Width="28"
                                                              Height="28"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Text info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               ToolTip="{Binding Title}" />
                                                    <TextBlock Text="{Binding Artist}"
                                                               Foreground="#B0B5BA"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,2,0,0"
                                                               ToolTip="{Binding Artist}" />
                                                    <TextBlock Text="{Binding Album}"
                                                               Foreground="#757D86"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,1,0,0"
                                                               Visibility="{Binding Album, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Progress bar (if timeline available) -->
                                            <Grid Grid.Row="2"
                                                  Margin="0,2,0,8"
                                                  Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ProgressBar Grid.Row="0"
                                                             Height="3"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                             Foreground="#0078D4"
                                                             Background="#30FFFFFF"
                                                             BorderThickness="0" />

                                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PositionText}"
                                                               FontSize="10"
                                                               Foreground="#80FFFFFF"
                                                               HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding DurationText}"
                                                               FontSize="10"
                                                               Foreground="#80FFFFFF"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </Grid>

                                            <!-- Row 3: Playback Controls -->
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,4,0,0">
                                                <!-- Previous -->
                                                <Button Style="{StaticResource FluentCircleButtonStyle}"
                                                        Command="{Binding SkipPreviousCommand}"
                                                        IsEnabled="{Binding CanSkipPrevious}"
                                                        Margin="0,0,12,0"
                                                        ToolTip="Previous Track">
                                                    <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"
                                                          Fill="#FFFFFF"
                                                          Width="14"
                                                          Height="14"
                                                          Stretch="Uniform" />
                                                </Button>

                                                <!-- Play / Pause -->
                                                <Button Style="{StaticResource FluentPlayButtonStyle}"
                                                        Command="{Binding TogglePlayPauseCommand}"
                                                        ToolTip="Play / Pause">
                                                    <Grid>
                                                        <!-- Play Icon (shown when paused) -->
                                                        <Path Data="M8 5v14l11-7z"
                                                              Fill="#FFFFFF"
                                                              Width="16"
                                                              Height="16"
                                                              Stretch="Uniform"
                                                              Margin="2,0,0,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <!-- Pause Icon (shown when playing) -->
                                                        <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                                              Fill="#FFFFFF"
                                                              Width="16"
                                                              Height="16"
                                                              Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Button>

                                                <!-- Next -->
                                                <Button Style="{StaticResource FluentCircleButtonStyle}"
                                                        Command="{Binding SkipNextCommand}"
                                                        IsEnabled="{Binding CanSkipNext}"
                                                        Margin="12,0,0,0"
                                                        ToolTip="Next Track">
                                                    <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                                                          Fill="#FFFFFF"
                                                          Width="14"
                                                          Height="14"
                                                          Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
