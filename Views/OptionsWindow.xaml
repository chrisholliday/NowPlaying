<Window x:Class="NowPlaying.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now Playing Options"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Options" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Choose how Now Playing starts and appears."
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource SettingsSecondaryTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SettingsCardBrush}"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,16">
            <CheckBox x:Name="StartupCheckBox"
                      Content="Run Now Playing when I sign in"
                      FontSize="14"
                      VerticalContentAlignment="Center"
                      Checked="StartupCheckBox_Changed"
                      Unchecked="StartupCheckBox_Changed" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox x:Name="ThemeComboBox"
                      SelectedIndex="0"
                      SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Use Windows setting" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
            <TextBlock Text="System follows the Windows app-mode setting."
                       Margin="0,7,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SettingsSecondaryTextBrush}" />
        </StackPanel>

        <Button Grid.Row="3"
                Content="Done"
                Width="88"
                Height="34"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="DoneButton_Click" />
    </Grid>
</Window>